# ── Binance API credentials ──────────────────────────────────────────────────
# Spot trading only. No withdrawal permissions. Restrict to VPS IP.
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# ── Trading behaviour ─────────────────────────────────────────────────────────
# Set to True to simulate execution against live prices without placing orders.
DRY_RUN=True

# Minimum 24-hour USDT volume a pair must have to enter the triangle graph.
MIN_VOLUME_USDT=1000000.0

# Net return must exceed 1.0 + SAFETY_MARGIN to be considered an opportunity.
SAFETY_MARGIN=0.0015

# Discard a triangle if any of its book prices is older than this many ms.
MAX_TICK_AGE_MS=300

# ── Risk limits ───────────────────────────────────────────────────────────────
# Maximum USDT allocated to a single triangle execution.
MAX_POSITION_USDT=100.0

# Bot self-pauses if cumulative daily PnL drops below this value (negative USDT).
DAILY_LOSS_LIMIT_USDT=-50.0

# Maximum number of triangle executions that may run concurrently.
MAX_CONCURRENT_TRIANGLES=2

# ── Redis (control-plane only) ────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
CONTROL_PLANE_POLL_INTERVAL_SECONDS=2

# ── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
